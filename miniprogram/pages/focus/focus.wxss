.focus-page{height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 36rpx) 32rpx 44rpx;display:grid;grid-template-rows:auto auto 1fr auto;background:#f7eedc}.focus-top{text-align:center;font-weight:800;font-size:30rpx}.stage{font-size:23rpx;color:#8b755f;margin-top:8rpx}.progress{height:14rpx;border:2rpx solid #87694b;border-radius:10rpx;overflow:hidden;margin:24rpx 18rpx}.progress view{height:100%;background:#a7b37c}.focus-center{display:flex;flex-direction:column;align-items:center;justify-content:center}.bakeco{width:260rpx;height:280rpx;border:5rpx solid #76573d;border-radius:48% 48% 42% 42%;position:relative;background:#c7935d;display:flex;align-items:center;justify-content:center}.ear{position:absolute;top:-30rpx;width:80rpx;height:80rpx;border:5rpx solid #76573d;border-radius:50%;background:#c7935d;z-index:0}.ear.left{left:12rpx}.ear.right{right:12rpx}.face{font-size:74rpx;z-index:2}.hat{position:absolute;top:-60rpx;width:150rpx;height:82rpx;border:5rpx solid #76573d;border-radius:50% 50% 20% 20%;background:#fff9eb;display:flex;align-items:center;justify-content:center;font-weight:900;z-index:1}.clock{font-size:82rpx;font-weight:900;letter-spacing:4rpx;margin-top:42rpx}.focus-quote{font-size:25rpx;color:#7d654f;margin-top:20rpx}.focus-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.focus-actions .primary-button:only-child{grid-column:1/-1}.danger{color:#8e5142}.modal-mask{position:fixed;inset:0;background:rgba(53,39,27,.5);display:flex;align-items:flex-end;z-index:10}.exit-card{background:#fff9eb;border-radius:36rpx 36rpx 0 0;padding:38rpx 32rpx calc(env(safe-area-inset-bottom) + 30rpx);width:100%}.exit-card button{width:100%;margin-top:18rpx}.exit-card text{font-size:21rpx;font-weight:400}.text-button{border:0;background:transparent;color:#8e5142;padding:20rpx}
