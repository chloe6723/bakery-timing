.ticket{background:#fff9eb;border:3rpx dashed #9b7956;border-radius:26rpx;padding:24rpx;margin-bottom:20rpx}.ticket .primary-button{margin-top:20rpx}.vip{border-style:solid;background:#fff3d2}.create{width:100%;margin-top:12rpx}.delivery-status{margin-top:20rpx;padding:18rpx;border-radius:20rpx;background:#e6e5c9;text-align:center;font-weight:800}.planner{background:#fff9eb;border:3rpx solid #b89d79;border-radius:28rpx;padding:24rpx;margin-bottom:24rpx}.plan-clock{font-size:34rpx;font-weight:900}.plan-option{padding:18rpx;margin-top:12rpx;border:2rpx solid #ddc5a3;border-radius:20rpx}.plan-option.selected{background:#edf0d6;border-color:#83915f}.tidy{font-size:22rpx;color:#8b755f;margin-top:8rpx}
