<view class="page">
  <view class="topbar"><view class="back-home" bindtap="goHome">‹ 面包房</view></view><view class="title">订单管理</view>
  <scroll-view scroll-x="true"><view class="chips"><button wx:for="{{filters}}" wx:key="*this" class="chip {{filter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="setFilter">{{item}}</button></view></scroll-view>
  <view class="planner"><view class="row between"><view><view class="section-title">新建专注计划</view><view class="muted">净专注 {{planMinutes}} 分钟 · 最多 5 个面包</view></view><view class="plan-clock">{{planMinutes / 60}}h</view></view><slider min="30" max="480" step="30" value="{{planMinutes}}" activeColor="#93A26C" backgroundColor="#E3D2B7" block-color="#F2C56B" bindchange="setPlanMinutes"/><view class="plan-option {{selectedPlan === index ? 'selected' : ''}}" wx:for="{{plans}}" wx:key="index" data-index="{{index}}" bindtap="selectPlan"><view class="row between"><strong>推荐 {{index + 1}}</strong><span class="tag">{{item.usedMinutes}} 分钟</span></view><view class="muted"><text wx:for="{{item.items}}" wx:for-item="bread" wx:key="index">{{bread.name}}{{index < item.items.length - 1 ? ' ＋ ' : ''}}</text></view><view wx:if="{{item.remainingMinutes}}" class="tidy">剩余 {{item.remainingMinutes}} 分钟整理店铺</view></view><button class="primary-button" bindtap="createPlan">生成预约订单</button></view>
  <view wx:if="{{vipVisible}}" class="ticket vip"><view class="row between"><view class="section-title">小票 #A-021</view><view class="tag">即时 VIP</view></view><view>鹿小姐 · 盐可颂 × 1</view><view class="muted">接受后 6 小时内开始 · 最长 120 分钟</view><button wx:if="{{!vipOrder || vipOrder.status === 'PENDING'}}" class="primary-button" bindtap="acceptVip">接受订单</button><button wx:elif="{{vipOrder.status === 'ACCEPTED'}}" class="primary-button" bindtap="startVip">开始制作</button><button wx:elif="{{vipOrder.status === 'READY_FOR_PICKUP'}}" class="primary-button" data-id="A-021" bindtap="deliver">请客人来店取货</button><view wx:else class="delivery-status">{{vipOrder.status === 'DELIVERED' ? '已经交付' : '制作中'}}</view></view>
  <block wx:for="{{orders}}" wx:key="id"><view wx:if="{{item.type === 'APPOINTMENT'}}" class="ticket"><view class="row between"><view class="section-title">小票 #{{item.id}}</view><view class="tag">预约</view></view><view>{{item.customer}} · {{item.items.length}} 个面包</view><view class="muted">{{item.recipe}}</view><view wx:if="{{item.remainingMinutes}}" class="muted">另有 {{item.remainingMinutes}} 分钟整理店铺</view><button wx:if="{{item.status === 'PENDING'}}" class="primary-button" data-id="{{item.id}}" bindtap="startOrder">开始整张订单</button><button wx:elif="{{item.status === 'READY_FOR_PICKUP'}}" class="primary-button" data-id="{{item.id}}" bindtap="deliver">请客人来店取货</button><view wx:else class="delivery-status">{{item.status}}</view></view></block>
</view>
