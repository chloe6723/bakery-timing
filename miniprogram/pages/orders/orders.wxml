<view class="page">
  <view class="topbar"><view class="back-home" bindtap="goHome">‹ 面包房</view></view>
  <view class="title">订单管理</view>
  <scroll-view scroll-x="true"><view class="chips"><button wx:for="{{filters}}" wx:key="*this" class="chip {{filter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="setFilter">{{item}}</button></view></scroll-view>
  <view class="ticket vip">
    <view class="row between"><view class="section-title">小票 #A-021</view><view class="tag">即时 VIP</view></view>
    <view>鹿小姐 · 盐可颂 × 1</view><view class="muted">今天 15:30 前 · 需要专注 120 分钟</view>
    <button wx:if="{{!orders[0] || orders[0].status === 'PENDING'}}" class="primary-button" bindtap="startVip">开始制作</button>
    <button wx:elif="{{orders[0].status === 'READY_FOR_PICKUP'}}" class="primary-button" data-id="A-021" bindtap="deliver">请客人来店取货</button>
    <view wx:else class="delivery-status">{{orders[0].status === 'DELIVERED' ? '已经交付' : '制作中'}}</view>
  </view>
  <view class="ticket"><view class="row between"><view class="section-title">小票 #R-118</view><view class="tag">周期</view></view><view>每周一、三、五 · 阅读论文</view><view class="muted">下一次：明天 09:00 · 90 分钟</view></view>
  <view class="ticket"><view class="row between"><view class="section-title">零售 #S-404</view><view class="tag">完成</view></view><view>刺猬先生买走日式红豆包</view><view class="muted">收到 66 金币 · 小费：一朵花</view></view>
  <button class="soft-button create">＋ 新建预约订单</button>
</view>
