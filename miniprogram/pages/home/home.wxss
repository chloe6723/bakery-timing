.home{height:100vh;position:relative;overflow:hidden;background:#f5e7c9}.hero{position:absolute;inset:0;width:100%;height:100%;filter:saturate(.78)}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,249,235,.9) 0%,rgba(255,249,235,0) 25%,rgba(72,48,29,.04) 63%,rgba(71,46,28,.58) 100%)}.home-top{position:absolute;z-index:3;top:calc(env(safe-area-inset-top) + 18rpx);left:24rpx;right:24rpx;display:flex;gap:12rpx;align-items:center}.home-copy{position:absolute;z-index:2;top:150rpx;left:36rpx;right:36rpx;text-align:center}.home-title{font-size:54rpx;font-weight:900;text-shadow:0 2rpx #fff9eb}.quote{font-size:25rpx;margin-top:10rpx;color:#765a42}.picker-card{position:absolute;z-index:3;left:28rpx;right:28rpx;bottom:154rpx;padding:20rpx;background:rgba(255,249,235,.94);border:3rpx solid #936f49;border-radius:34rpx}.minute-row{display:flex;gap:12rpx}.minute{width:78rpx;height:58rpx;border-radius:20rpx;border:2rpx solid #9a7b59;background:#fffaf0;padding:0;line-height:58rpx;font-size:24rpx;flex:none}.minute.active{background:#dce4bd;font-weight:800}.custom-time{display:flex;justify-content:space-between;margin:12rpx 6rpx 0;font-size:23rpx}.recipe-line{margin:12rpx 2rpx}.bread-mark{font-size:54rpx}.home-tabs{position:absolute;z-index:4;bottom:0;left:0;right:0;height:132rpx;padding-bottom:env(safe-area-inset-bottom);display:grid;grid-template-columns:repeat(3,1fr);background:#fff9eb;border-top:3rpx solid #9a7b59}.home-tabs button{border:0!important;background:transparent!important;border-radius:0!important;padding:12rpx 0;color:#4d3828;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.2}.home-tabs text{font-size:38rpx;margin-bottom:8rpx}.home-tabs label{font-size:23rpx}
