.shelf-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:20rpx}.shelf-grid .card{margin:0}.shelf-item{min-height:210rpx}.bread-icon{font-size:60rpx;text-align:center;margin:12rpx}.shelf-name{min-height:72rpx;font-weight:800}.order-button{width:54rpx;height:48rpx;padding:0;border:2rpx solid #9b7956;border-radius:14rpx;background:#fff9eb}.more-button{min-height:210rpx;font-size:56rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}.more-button text{font-size:23rpx}.extra{padding:14rpx 0;border-bottom:2rpx solid #e3cfb2}.waiting-title{margin-top:32rpx}.checkout{width:auto;margin:0;padding:17rpx 24rpx}
