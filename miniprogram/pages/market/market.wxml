<view class="page"><view class="topbar"><view class="back-home" bindtap="goHome">‹ 面包房</view><view class="grow"></view><view class="coin-pill">● {{coins}}</view></view><view class="title">麦子集市</view><scroll-view scroll-x="true"><view class="chips"><button wx:for="{{categories}}" wx:key="*this" class="chip {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="setCategory">{{item}}</button></view></scroll-view><view wx:if="{{category === '二手收购'}}" class="card"><view class="section-title">失败品兑换猫粮</view><view class="muted">猫粮库存：{{catFood}} 份</view><view class="divider"></view><view class="row between"><view>没发好的面团 × {{failedBakes['没发好的面团'] || 0}}</view><button class="buy" data-item="没发好的面团" bindtap="exchangeCatFood">兑换</button></view><view class="divider"></view><view class="row between"><view>没烤好的面包 × {{failedBakes['没烤好的面包'] || 0}}</view><button class="buy" data-item="没烤好的面包" bindtap="exchangeCatFood">兑换</button></view></view><view wx:else class="card market-item" wx:for="{{items}}" wx:key="name"><view class="item-icon">{{item.icon}}</view><view class="grow"><view class="section-title">{{item.name}}</view><view class="muted">{{item.desc}}</view></view><button class="buy" data-id="{{item.id}}" bindtap="buy">● {{item.price}}</button></view></view>
