<view class="page"><view class="topbar"><view class="back-home" bindtap="goHome">‹ 面包房</view><view class="grow"></view><view class="coin-pill">● {{coins}}</view></view><view class="title">麦子集市</view><scroll-view scroll-x="true"><view class="chips"><button wx:for="{{categories}}" wx:key="*this" class="chip {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="setCategory">{{item}}</button></view></scroll-view><view class="card market-item" wx:for="{{items}}" wx:key="name"><view class="item-icon">{{item.icon}}</view><view class="grow"><view class="section-title">{{item.name}}</view><view class="muted">{{item.desc}}</view></view><button class="buy" data-id="{{item.id}}" bindtap="buy">● {{item.price}}</button></view></view>
