page{background:#f7eedc;color:#4d3828;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{min-height:100vh;padding:calc(env(safe-area-inset-top) + 24rpx) 28rpx 40rpx;box-sizing:border-box}.topbar{height:80rpx;display:flex;align-items:center;gap:14rpx}.top-icon,.coin-pill,.round-button,.chip,.soft-button,.primary-button{border:3rpx solid #8a6d4e;background:#fff9eb;color:#4d3828;box-shadow:none}.top-icon{width:68rpx;height:68rpx;border-radius:22rpx;padding:0;display:flex;align-items:center;justify-content:center}.coin-pill{border-radius:34rpx;padding:13rpx 22rpx;font-weight:700}.grow{flex:1}.title{font-size:42rpx;font-weight:800;margin:26rpx 0 20rpx}.subtitle{font-size:24rpx;color:#836e5a}.card{background:#fff9eb;border:3rpx solid #b89d79;border-radius:28rpx;padding:24rpx;margin-bottom:20rpx}.primary-button{border-radius:30rpx;background:#f2c56b;font-weight:800;padding:24rpx;line-height:1}.soft-button{border-radius:24rpx;padding:18rpx 24rpx;line-height:1}.chips{display:flex;gap:12rpx;white-space:nowrap;margin-bottom:20rpx}.chip{font-size:24rpx;border-radius:20rpx;padding:12rpx 20rpx}.chip.active{background:#dbe1bd}.section-title{font-size:30rpx;font-weight:800;margin-bottom:14rpx}.row{display:flex;align-items:center;gap:18rpx}.between{justify-content:space-between}.muted{color:#8b755f;font-size:24rpx}.metric{font-size:40rpx;font-weight:800}.tag{border:2rpx solid #8a6d4e;border-radius:14rpx;padding:5rpx 12rpx;font-size:21rpx}.divider{height:2rpx;background:#e0ccb0;margin:18rpx 0}.empty{padding:80rpx 20rpx;text-align:center;color:#8b755f}.back-home{font-weight:800}.grid-two{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.scroll-x{width:100%}
